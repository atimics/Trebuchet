      "packages/core/**/*",
      "README.md",
      "public/**/*",
      "c/build/**/*",
      "package.json",
      "packages/runtime/**/*"
    ],
    "asarUnpack": [
      "public/**/*",
      "public/intro.mp4",
      "public/audio/warTheme.mp3",
      "public/audio/click.flac",
      "public/audio/checkbox.wav",
      "public/audio/coins.wav",
      "public/audio/menuSelect.wav",
      "public/audio/expand.wav",
      "public/audio/collapse.ogg",
      "public/audio/expandStep.ogg",
      "public/audio/collapseStep.ogg",
      "c/build/**/*"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg"
      ],
      "artifactName": "Trebuchet-${version}-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-Setup.${ext}",
      "preCompressedFileExtensions": []
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Development",
      "executableName": "Trebuchet",
      "artifactName": "Trebuchet-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "packageName": "trebuchet-desktop",
      "artifactName": "trebuchet-desktop_${version}_${arch}.${ext}"
    }
  }
}
