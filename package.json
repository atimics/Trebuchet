    "esbuild": "^0.25.10",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "axios": "^1.19.0",
    "brace-expansion@<1.1.18": "1.1.18",
    "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
