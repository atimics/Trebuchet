    "@electron/get": {
      "undici": "^7.29.0"
    },
    "node-gyp": {
      "undici": "^6.27.0"
    },
    "uuid": "^11.1.1",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.makesometokens.trebuchet",
    "productName": "Trebuchet",
    "executableName": "Trebuchet",
    "publish": null,
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "lpConstants.js",
