{
  "name": "@anoversizedmoosewithsocks/trebuchet-desktop",
  "desktopName": "trebuchet",
  "version": "1.0.0",
  "description": "Trebuchet token launcher, packaged as a desktop app.",
  "main": "main.js",
  "bin": {
    "trebuchet": "packages/cli/bin/trebuchet.js"
  },
  "type": "module",
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "author": {
    "name": "AnOversizedMooseWithSocks",
    "email": "84553632+AnOversizedMooseWithSocks@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnOversizedMooseWithSocks/Trebuchet.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "scripts": {
    "start": "electron .",
    "start:v2": "electron . --v2",
    "start:classic": "electron . --classic",
    "web": "npm run build:c && npm run build:js && node server.js",
    "web:dev": "node --watch server.js",
    "cli": "node packages/cli/bin/trebuchet.js",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs",
    "test:cli": "node --test test/cli.test.mjs",
    "test:web": "node --test test/web-bundle.test.mjs",
    "web:serve": "node scripts/web-server.mjs",
    "web:deploy": "wrangler deploy",
    "web:preview": "wrangler dev --port 8787",
    "web:check": "node --check public/v2/app.js && node --check packages/core/src/streamlined-launch.js && node --test test/web-bundle.test.mjs",
    "test:e2e": "node test/e2e/ui-flows.mjs --mobile",
    "test:e2e:v2": "node test/e2e/v2-flows.mjs",
    "test:e2e:nft:localnet": "node test/e2e/v2-nft-localnet.mjs",
    "test:e2e:devnet": "node test/e2e/devnet-transactions.mjs",
    "test:e2e:devnet:recovery": "node test/e2e/devnet-recovery-drills.mjs",
    "test:electron:v2": "node test/e2e/electron-v2-smoke.mjs",
    "test:electron:v2:packaged": "node test/e2e/electron-v2-smoke.mjs --packaged",
    "test:v2:viewport": "node test/v2-viewport-smoke.mjs",
    "devnet-launch": "node scripts/devnet-launch.mjs",
    "test:visual": "node scripts/visual-diff.mjs",
    "test:visual:golden": "node scripts/visual-diff.mjs --golden",
    "test:visual:golden:linux": "node scripts/visual-diff.mjs --golden --platform linux",
    "shots": "node scripts/capture-screenshots.mjs",
    "shots:marketing": "node scripts/capture-marketing-assets.mjs",
    "smoke:mainnet:readonly": "node test-token2022-compat.mjs",
    "build": "electron-builder",
    "build:gif-codecs": "esbuild scripts/gif-codecs-entry.mjs --bundle --format=esm --platform=browser --target=chrome100 --minify --outfile=public/vendor/gif-codecs.mjs && node scripts/build-gif-worker.mjs",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:js": "node scripts/build-app-js.mjs",
    "build:c": "node scripts/build-c.mjs",
    "check:package": "node scripts/check-package-files.mjs",
    "check:audit": "node scripts/audit-policy.mjs",
    "release:gate": "node scripts/production-release-gate.mjs",
    "test:architecture": "node --test packages/core/test/*.test.mjs packages/runner/test/*.mjs packages/runtime/test/*.test.mjs",
    "test:e2e:runtime-token:localnet": "node test/e2e/runtime-token-localnet.mjs",
    "test:e2e:runtime-upload:localnet": "node test/e2e/runtime-upload-localnet.mjs",
    "test:e2e:runtime-swap:localnet": "node test/e2e/runtime-swap-localnet.mjs",
    "test:e2e:runtime-withdrawal:localnet": "node test/e2e/runtime-withdrawal-localnet.mjs",
    "test:e2e:runtime-support:localnet": "node test/e2e/runtime-support-localnet.mjs"
  },
  "files": [
    "build/**/*",
    "docs/**/*",
    "lpConstants.js",
    "lpDistribution.js",
    "lpFeeTiers.js",
    "lpMintCompat.js",
    "main.js",
